{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Explorer",
  "version": "1.0.0",
  "identifier": "com.kde.fileexplorer",
  "build": {
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "File Explorer",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#fafbfd",
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "resources": ["../dist/renderer/reversal-icons/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}